{
  "name": "solenoid-node",
  "version": "1.0.1",
  "description": "Single-agent AI harness for LM Studio and OpenRouter models",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "solenoid": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "bun run --watch src/cli.ts",
    "start": "bun run src/cli.ts",
    "build": "bun run scripts/build.ts",
    "prepare": "bun run build",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "lm-studio",
    "openrouter",
    "cli",
    "terminal",
    "bun"
  ],
  "author": "Eli Collinson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/elicollinson/solenoid-node"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.3",
    "@arizeai/openinference-semantic-conventions": "^2",
    "@elicollinson/solenoid-security": "github:elicollinson/solenoid-security#7914c4270eeb25b47c2313eb327500a3b8c8edc6",
    "@inkjs/ui": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.210.0",
    "@opentelemetry/sdk-trace-base": "^2",
    "@pppp606/ink-chart": "^0.2.5",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ink": "^6.0.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "openai": "^6",
    "react": "^19.0.0",
    "yaml": "^2.7.1",
    "zod": "^4"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@biomejs/biome": "^1.9.0",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "bun-types": "^1.1.0",
    "ink-testing-library": "^4.0.0",
    "npm": "^11.15.0",
    "react-devtools-core": "^6.1.1",
    "standard-version": "^9.5.0",
    "typescript": "^5.7.3"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
