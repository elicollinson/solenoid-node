{
  "name": "solenoid-node",
  "version": "1.0.5",
  "description": "Single-agent AI harness for LM Studio and OpenRouter models",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "solenoid": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "bun run --watch src/cli.ts",
    "start": "bun run src/cli.ts",
    "build": "bun run scripts/build.ts",
    "prepare": "bun run build",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "eval": "bun run evals/run.ts",
    "verify": "bun run lint && bun run typecheck && bun test && bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "lm-studio",
    "openrouter",
    "cli",
    "terminal",
    "bun"
  ],
  "author": "Eli Collinson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/elicollinson/solenoid-node"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.5",
    "@arizeai/openinference-semantic-conventions": "^2",
    "@elicollinson/solenoid-security": "github:elicollinson/solenoid-security#7914c4270eeb25b47c2313eb327500a3b8c8edc6",
    "@inkjs/ui": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^3",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/sdk-trace-base": "^2",
    "@pppp606/ink-chart": "^0.2.5",
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "ink": "^8.0.0",
    "marked": "^18.2.1",
    "marked-terminal": "^8.0.0",
    "openai": "^7",
    "react": "^19.0.0",
    "yaml": "^2.7.1",
    "zod": "^4"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@babel/core": "8.1.2",
    "@biomejs/biome": "^2.6.8",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "bun-types": "^1.1.0",
    "ink-testing-library": "^4.0.0",
    "react-devtools-core": "^8.0.0",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ],
  "overrides": {
    "@hono/node-server": "^2.1.3",
    "deepmerge": "file:./vendor/deepmerge",
    "uuid": "^11.1.1"
  }
}
